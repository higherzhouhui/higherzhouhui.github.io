      "setting": "早上出门前，你问朋友或前台今天热不热、会不会下雨。",
      "lines": [
        {
          "role": "你（男）",
          "th": "วันนี้ อากาศเป็นไงครับ",
          "roman": "wan-nee a-gat pen ngai khrap",
          "zh": "今天天气怎么样？（男）",
          "speak": "วันนี้ อากาศเป็นไงครับ"
        },
        {
          "role": "朋友",
          "th": "ร้อนมากเลย",
          "roman": "ron mak loei",
          "zh": "很热啊",
          "speak": "ร้อนมากเลย"
        },
        {
          "role": "你（男）",
          "th": "ฝนตกไหมครับ",
          "roman": "fon tok mai khrap",
          "zh": "下雨吗？（男）",
          "speak": "ฝนตกไหมครับ"
        },
        {
          "role": "朋友",
          "th": "อาจจะตกบ่าย",
          "roman": "at ja tok bai",
          "zh": "下午可能会下",
          "speak": "อาจจะตกบ่าย"
        },
        {
          "role": "你（男）",
          "th": "งั้นผมเอาร่มด้วยครับ",
          "roman": "ngan phom ao rom duay khrap",
          "zh": "那我带伞。（男）",
          "speak": "งั้นผมเอาร่มด้วยครับ"
        }
      ]
    },
    {
